@page "/admin/audit-logs"
@layout AdminLayout
@attribute [Authorize(Policy = AppPolicies.AdminOrManager)]
@using WebShopABMATIC.Application.Admin.AuditLogs
@using WebShopABMATIC.Application.Audit
@using WebShopABMATIC.Application.Common
@using WebShopABMATIC.Application.Auth
@using WebShopABMATIC.Application.Ports
@using WebShopABMATIC.Web.Services
@inject IAuditLogAdminPort AuditPort
@inject IGridExportService GridExport

<PageTitle>Audit Logs</PageTitle>

<div class="entity-page">
    <a class="btn btn-secondary btn-back mb-3" href="/admin/hub/logs" data-enhance-nav="false"><span class="oi oi-arrow-left"></span> Back to Logs hub</a>
    <div class="entity-page-header page-header d-flex flex-wrap justify-content-between align-items-start gap-2">
        <div>
            <h1 class="h3 mb-1"><i class="bi bi-shield-check text-primary"></i> Audit Logs</h1>
            <p class="mb-0">Auth, CRUD, and application events from legacy <code>[Logging].[Error]</code>.</p>
        </div>
        <button type="button" class="btn btn-success" @onclick="ApplyFiltersAsync" disabled="@_loading" title="Refresh">
            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
        </button>
    </div>

    <div class="card shadow-sm border mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label" for="f-from">Date From</label>
                    <InputDate id="f-from" class="form-control form-control-sm" @bind-Value="_fromDate" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="f-to">Date To</label>
                    <InputDate id="f-to" class="form-control form-control-sm" @bind-Value="_toDate" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="f-action">Action</label>
                    <select id="f-action" class="form-select form-select-sm" @bind="_actionDraft">
                        <option value="">All</option>
                        @foreach (var action in AuditActions.All)
                        {
                            <option value="@action">@action</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="f-module">Module</label>
                    <select id="f-module" class="form-select form-select-sm" @bind="_moduleDraft">
                        <option value="">All</option>
                        @foreach (var module in LegacyAuditModules.All)
                        {
                            <option value="@module">@module</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="f-user">User</label>
                    <input id="f-user" class="form-control form-control-sm" placeholder="Username" @bind="_userDraft" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="f-status">Status</label>
                    <select id="f-status" class="form-select form-select-sm" @bind="_statusDraft">
                        <option value="">All</option>
                        <option value="success">Success</option>
                        <option value="failed">Failed</option>
                    </select>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="button" class="btn btn-primary" @onclick="ApplyFiltersAsync" disabled="@_loading" title="Apply filter criteria">
                    <i class="bi bi-funnel-fill me-1"></i>Apply Filters
                </button>
                <button type="button" class="btn btn-danger" @onclick="ClearFiltersAsync" disabled="@_loading" title="Clear all filters">
                    <i class="bi bi-x-circle-fill me-1"></i>Clear
                </button>
                <button type="button" class="btn btn-warning" @onclick="() => _showLegend = true" title="Action badge legend">
                    <i class="bi bi-question-circle-fill me-1"></i>Badges legend
                </button>
                <AdminExportDropdown Disabled="@ExportDisabled" OnExport="ExportGridAsync" />
            </div>
        </div>
    </div>

    <div class="card shadow-sm border entity-grid-card">
        <div class="card-header bg-white entity-grid-toolbar">
            <h2 class="h6 mb-0 fw-bold">Events</h2>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Timestamp</th>
                        <th>Severity</th>
                        <th>Action</th>
                        <th>Module</th>
                        <th>User</th>
                        <th>Entity ID</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">Loading…</td></tr>
                    }
                    else if (!string.IsNullOrEmpty(_error))
                    {
                        <tr><td colspan="8" class="text-center text-danger py-4">@_error</td></tr>
                    }
                    else if (_result is null || _result.Items.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No records found.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in _result.Items)
                        {
                            <tr class="@(item.Success ? null : "table-danger")">
                                <td>@item.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>
                                    <span class="badge @(item.Success ? "bg-info text-dark" : "bg-danger")">@item.Severity</span>
                                </td>
                                <td><AuditActionBadge Action="@item.Action" /></td>
                                <td>@item.EntityName</td>
                                <td>@item.UserDisplayName</td>
                                <td>@(string.IsNullOrWhiteSpace(item.EntityId) ? "—" : item.EntityId)</td>
                                <td class="text-center">
                                    @if (item.Success)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Success"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger" title="Failed"></i>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-info text-white" @onclick="() => ShowDetailAsync(item.Id)" title="View details">
                                        <i class="bi bi-eye-fill"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <AdminGridPagination TotalCount="@(_result?.TotalCount ?? 0)" Page="@(_filter.Page)" PageSize="@(_filter.PageSize)" Loading="@_loading" OnPageChanged="ChangePageAsync" />
    </div>
</div>

@if (_detail is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Event #@_detail.Id</h5>
                    <button type="button" class="btn-close" @onclick="CloseDetail"></button>
                </div>
                <div class="modal-body">
                    <dl class="row mb-0 small">
                        <dt class="col-sm-3">When</dt><dd class="col-sm-9">@_detail.Timestamp.ToString("F")</dd>
                        <dt class="col-sm-3">Action</dt><dd class="col-sm-9"><AuditActionBadge Action="@_detail.Action" /></dd>
                        <dt class="col-sm-3">Module</dt><dd class="col-sm-9">@_detail.EntityName</dd>
                        <dt class="col-sm-3">User</dt><dd class="col-sm-9">@_detail.UserDisplayName</dd>
                        <dt class="col-sm-3">Entity ID</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(_detail.EntityId) ? "—" : _detail.EntityId)</dd>
                        <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(_detail.Success ? "Success" : "Failed")</dd>
                        <dt class="col-sm-3">Message</dt><dd class="col-sm-9"><pre class="mb-0 small">@_detail.AdditionalInfo</pre></dd>
                        @if (!string.IsNullOrWhiteSpace(_detail.ErrorMessage))
                        {
                            <dt class="col-sm-3">Inner</dt><dd class="col-sm-9"><pre class="mb-0 small">@_detail.ErrorMessage</pre></dd>
                        }
                    </dl>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDetail">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showLegend)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4); z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Action badges</h5>
                    <button type="button" class="btn-close" @onclick="() => _showLegend = false"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var action in AuditActions.All)
                        {
                            <AuditActionBadge Action="@action" />
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showLegend = false">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private AuditLogListFilter _filter = new();
    private PagedResult<AuditLogListItemDto>? _result;
    private AuditLogDetailDto? _detail;
    private bool _loading = true;
    private string? _error;
    private bool _showLegend;

    private DateTime? _fromDate;
    private DateTime? _toDate;
    private string _actionDraft = "";
    private string _moduleDraft = "";
    private string _userDraft = "";
    private string _statusDraft = "";

    protected override async Task OnInitializedAsync() => await ApplyFiltersAsync();

    private async Task ApplyFiltersAsync()
    {
        _filter.FromDate = _fromDate;
        _filter.ToDate = _toDate;
        _filter.Action = string.IsNullOrWhiteSpace(_actionDraft) ? null : _actionDraft;
        _filter.EntityName = string.IsNullOrWhiteSpace(_moduleDraft) ? null : _moduleDraft;
        _filter.UserSearch = string.IsNullOrWhiteSpace(_userDraft) ? null : _userDraft.Trim();
        _filter.SuccessOnly = _statusDraft == "success" ? true : null;
        _filter.FailuresOnly = _statusDraft == "failed" ? true : null;
        _filter.Severity = null;
        _filter.Page = 1;
        await LoadAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _fromDate = null;
        _toDate = null;
        _actionDraft = "";
        _moduleDraft = "";
        _userDraft = "";
        _statusDraft = "";
        _filter = new AuditLogListFilter();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _result = await AuditPort.GetAuditTrailAsync(_filter);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _result = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ChangePageAsync(int page)
    {
        if (page < 1) return;
        _filter.Page = page;
        await LoadAsync();
    }

    private async Task ShowDetailAsync(long id)
    {
        _detail = await AuditPort.GetDetailAsync(id);
    }

    private void CloseDetail() => _detail = null;

    private bool ExportDisabled => _loading || _result is null || _result.Items.Count == 0;

    private async Task ExportGridAsync(string format)
    {
        var request = BuildExportRequest();
        if (request is not null)
        {
            await GridExport.ExportAsync(format, request);
        }
    }

    private GridExportRequest? BuildExportRequest() =>
        GridExportBuilder.FromRows(
            "audit-logs",
            "Audit Logs",
            new[] { "Timestamp", "Severity", "Action", "Module", "User", "EntityId", "Status" },
            _result?.Items.Select(item => (IReadOnlyList<string>)new[]
            {
                GridExportBuilder.Cell(item.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")),
                GridExportBuilder.Cell(item.Severity),
                GridExportBuilder.Cell(item.Action),
                GridExportBuilder.Cell(item.EntityName),
                GridExportBuilder.Cell(item.UserDisplayName),
                GridExportBuilder.Cell(item.EntityId),
                GridExportBuilder.Cell(item.Success ? "Success" : "Failed")
            }));
}
