@using WebShopABMATIC.Application.Admin.Customers
@using WebShopABMATIC.Application.Admin.Lookups
@using WebShopABMATIC.Application.Ports
@inject ICustomerAdminPort CustomerPort

<div class="@CssClass">
    <label class="form-label" for="@InputId">@(Label ?? "Customer *")</label>
    <div class="input-group input-group-sm">
        <input id="@InputId" type="text" class="form-control form-control-sm" value="@DisplayText" readonly placeholder="Select a customer…" />
        <button type="button" class="btn btn-outline-primary" @onclick="OpenPicker" disabled="@Disabled" title="Search customer">
            <i class="bi bi-search"></i>
        </button>
        @if (CustomerId > 0 && !Disabled)
        {
            <button type="button" class="btn btn-outline-secondary" @onclick="ClearAsync" title="Clear customer">
                <i class="bi bi-x"></i>
            </button>
        }
    </div>
    @if (CustomerId <= 0 && ShowHint)
    {
        <div class="form-text text-danger">Select a customer before saving.</div>
    }
</div>

<CustomerPickerModal Show="_showPicker" OnSelected="OnCustomerSelectedAsync" OnClose="ClosePicker" />

@code {
    [Parameter] public int CustomerId { get; set; }
    [Parameter] public EventCallback<int> CustomerIdChanged { get; set; }
    [Parameter] public string? CustomerName { get; set; }
    [Parameter] public EventCallback<string?> CustomerNameChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string CssClass { get; set; } = "col-md-4";
    [Parameter] public string InputId { get; set; } = "f-customerid";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowHint { get; set; } = true;

    private bool _showPicker;
    private string? _resolvedName;
    private string? _resolvedLogin;
    private int _loadedForId;

    private string DisplayText =>
        CustomerId <= 0
            ? string.Empty
            : CustomerPickerResult.Format(
                CustomerId,
                !string.IsNullOrWhiteSpace(CustomerName) ? CustomerName : _resolvedName,
                _resolvedLogin);

    protected override async Task OnParametersSetAsync()
    {
        if (CustomerId <= 0)
        {
            _resolvedName = null;
            _resolvedLogin = null;
            _loadedForId = 0;
            return;
        }

        if (_loadedForId == CustomerId && (!string.IsNullOrWhiteSpace(CustomerName) || !string.IsNullOrWhiteSpace(_resolvedName)))
        {
            return;
        }

        try
        {
            var edit = await CustomerPort.GetForEditAsync(CustomerId);
            _resolvedName = edit?.CustomerName ?? "(not found)";
            _resolvedLogin = edit?.WebshopLogin;
            _loadedForId = CustomerId;
            if (edit is not null && string.IsNullOrWhiteSpace(CustomerName))
            {
                await CustomerNameChanged.InvokeAsync(edit.CustomerName);
            }
        }
        catch
        {
            _resolvedName = "(unavailable)";
            _resolvedLogin = null;
            _loadedForId = CustomerId;
        }
    }

    private void OpenPicker() => _showPicker = true;
    private void ClosePicker() => _showPicker = false;

    private async Task OnCustomerSelectedAsync(CustomerPickerResult result)
    {
        _resolvedName = result.CustomerName;
        _resolvedLogin = result.WebshopLogin;
        _loadedForId = result.CustomerId;
        await CustomerIdChanged.InvokeAsync(result.CustomerId);
        await CustomerNameChanged.InvokeAsync(result.CustomerName);
    }

    private async Task ClearAsync()
    {
        _resolvedName = null;
        _resolvedLogin = null;
        _loadedForId = 0;
        await CustomerIdChanged.InvokeAsync(0);
        await CustomerNameChanged.InvokeAsync(null);
    }
}
